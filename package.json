{
  "name": "frotalab",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema acadêmico de gerenciamento de frotas e logística",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "configure": "pnpm --dir back-end configure",
    "db": "pnpm --dir back-end db",
    "db:prepare": "pnpm --dir back-end db:prepare",
    "dev:api": "pnpm --dir back-end dev",
    "dev:web": "pnpm --dir front-end dev",
    "build:api": "pnpm --dir back-end build",
    "build:web": "pnpm --dir front-end build",
    "build": "pnpm build:api && pnpm build:web",
    "test:rules": "pnpm --dir back-end test:rules",
    "test:api": "pnpm --dir back-end test:api",
    "test:modules": "pnpm --dir back-end test:modules",
    "test": "pnpm --dir back-end test",
    "test:e2e": "pnpm --dir front-end test:e2e",
    "verify": "node scripts/verify.mjs",
    "erp:demo": "pnpm --dir back-end erp:demo"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "pg": "^8.16.3",
    "prettier": "^3.9.10"
  }
}
