{
  "name": "@frotalab/back-end",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node api/src/main.ts",
    "db": "node database/start.mjs",
    "db:prepare": "ts-node api/src/persistence/prepare.ts",
    "configure": "node scripts/configure.mjs",
    "build": "tsc",
    "test:rules": "node -r ts-node/register --test api/test/rules.test.ts",
    "test:api": "node -r ts-node/register --test --test-concurrency=1 api/test/api.test.ts",
    "test:modules": "node -r ts-node/register --test --test-concurrency=1 api/test/modules.test.ts",
    "test": "pnpm test:rules && pnpm test:api && pnpm test:modules",
    "erp:demo": "node scripts/erp-demo.mjs",
    "check:persistence": "node scripts/check-persistence.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "@nestjs/swagger": "11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "embedded-postgres": "latest",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
